# Frontend build inputs.
#
# Copy this file to .env.local for local development. Values are inlined into
# the client bundle by Vite, so nothing secret belongs here — this file is
# committed on purpose and .env is not.

# Base URL of the API. Leave as "/" when the UI is served by the API process
# (the normal case: one binary, one origin). Point it at the dev backend when
# running `pnpm dev` against a source build.
VITE_API_URL=/

# Clerk publishable key. The key is public by design; only the API holds a
# secret. Replace with the value from your Clerk instance, or leave the
# placeholder to run the UI without auth.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional Clerk frontend-API proxy. Leave unset to talk to Clerk's hosted
# frontend API (the normal case with a real Clerk tenant). Set it only when a
# proxy exists, e.g. the dev stack's `clerk-emulator`:
#   VITE_CLERK_PROXY_URL=http://localhost:4000
VITE_CLERK_PROXY_URL=
