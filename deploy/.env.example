# trakt-api environment template — copy to .env and fill real values.
# .env is gitignored; NEVER commit real secrets.

# Server
APP_ENV=development
PORT=8080

# Data layer (T0.4+)
DATABASE_URL=postgres://trakt:***@localhost:55432/trakt?sslmode=disable
DB_MAX_IDLE_CONNS=5
DB_MAX_OPEN_CONNS=20
DB_CONN_MAX_LIFETIME_MINUTES=30
DB_SLOW_QUERY_THRESHOLD_MS=10
REDIS_URL=redis://localhost:56379

# TMDB v4 read-access token (server-side only; never expose to browsers)
TMDB_API_TOKEN=<tmdb-v4-read-token>

# Clerk (Phase 2; dev defaults point at clerk-emulator)
CLERK_API_BASE_URL=http://localhost:4000
CLERK_SECRET_KEY=<clerk-secret>
# Svix signing secret for POST /v1/webhooks/clerk (Clerk Dashboard → Webhooks).
# Real Clerk instances MUST set this; dev clerk-emulator falls back to CLERK_SECRET_KEY.
CLERK_WEBHOOK_SECRET=
#
# Webhooks with the clerk-emulator: NOT delivered in server mode (the
# emulator only registers webhook subscriptions in-process, so there is no
# way to point it at your API). To exercise the user.created / user.updated
# / user.deleted pipeline locally, POST a Clerk-shaped payload to the
# dev-only simulate endpoint (registered only when APP_ENV != production):
#
#   curl -X POST http://localhost:8080/v1/dev/clerk-webhook-simulate \
#     -H 'Content-Type: application/json' \
#     -d '{"type":"user.created","data":{"id":"user_dev123","username":"dev","first_name":"Dev","last_name":"User","image_url":"","email_addresses":[]}}'
#
# Swap type for "user.updated" (full data) or "user.deleted" (id only).
# The real endpoint works unchanged once hosted Clerk + Dashboard webhooks
# are wired up.

# Admin/mod user whitelists (Clerk user IDs, comma-separated)
ADMIN_USER_IDS=
MOD_USER_IDS=

# Root key for at-rest credential encryption (issue #16 §2). Required: the server
# refuses to start without it, and it must be at least 32 characters. Generate:
#   openssl rand -base64 48
# Back this key up SEPARATELY from database dumps — a dump full of ciphertext
# that travels with the key gives no confidentiality, and losing it makes the
# encrypted secrets unrecoverable.
TKILLER_SECRET_KEY=<tkiller-secret-key>
#
# Legacy alias still accepted as a fallback (deployments that already set it keep
# running, and existing webhook secrets keep decrypting). New deployments should
# set TKILLER_SECRET_KEY instead. It was a 32-byte hex key: openssl rand -hex 32
WEBHOOK_SECRET_KEY=

# S3/MinIO (list covers, imports — T1+; avatars are Clerk-managed now)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=trakt
S3_SECRET_KEY=<minio-secret>

# Rate limiting (Phase 9d — sliding-window via Redis)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_PUBLIC_WINDOW=60
RATE_LIMIT_PUBLIC_MAX=30

# CORS (comma-separated allowed origins; empty = same-origin only)
CORS_ORIGINS=
