# Build context exclusions.
#
# Keeps the image build from copying things that are never compiled into it —
# and, more importantly, stops secrets and VCS history from reaching a layer.

# Version control and CI
.git
.gitignore
.github

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key

# Go build output
bin/
vendor/
*.log

# Frontend dependencies and build output.
# web/dist is rebuilt inside the frontend build stage; web/node_modules is
# installed there too, so shipping the host's copy would only shadow it.
web/node_modules
web/dist
web/.pnpm-store
web/e2e/test-results
web/e2e/playwright-report

# Local development state
.local/
tmp/
coverage.out

# Docs and editor cruft that is not needed to build
.idea
.vscode
.DS_Store
*.swp
