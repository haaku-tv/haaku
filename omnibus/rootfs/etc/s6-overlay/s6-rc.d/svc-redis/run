#!/command/with-contenv bash
# shellcheck shell=bash
set -euo pipefail
# shellcheck source=omnibus/rootfs/etc/tkiller-omnibus/lib.sh
source /etc/tkiller-omnibus/lib.sh

if ! enabled redis; then
  notify_ready
  exec sleep infinity
fi

export HOME=/config/redis
# A redis.conf in /config/redis replaces the persistence and logging defaults.
# The listener stays on the command line, which overrides the file, because the
# readiness check and the app's REDIS_URL both use it.
# The append-only file bounds what a crash loses to about a second: the app
# keeps rate-limit counters and cache entries here, and a snapshot alone can
# restore state older than the request that changed it.
config=(--save 60 1000 --appendfsync everysec --logfile '' --loglevel notice)
[[ -f /config/redis/redis.conf ]] && config=(/config/redis/redis.conf)
# The append-only file stays on even with a redis.conf: command-line options
# override the file.
exec_clean '' s6-notifyoncheck -d -n 0 -w 1000 \
  s6-setuidgid redis redis-server "${config[@]}" --appendonly yes \
    --bind 127.0.0.1 --port 6379 --unixsocket '' --protected-mode yes \
    --dir /config/redis --daemonize no --supervised no
