#!/command/with-contenv bash
# shellcheck shell=bash
# Create the trakt database. The tkiller role created the cluster, so it is the
# superuser and can do this itself; the app's migrations own everything else.
set -euo pipefail
# shellcheck source=omnibus/rootfs/etc/tkiller-omnibus/lib.sh
source /etc/tkiller-omnibus/lib.sh

enabled postgres || exit 0
export HOME=/config/tkiller

psql_tkiller() {
  s6-setuidgid tkiller psql -v ON_ERROR_STOP=1 -qAtX -h /run/postgresql -U tkiller "$@"
}

if [[ "$(psql_tkiller -d postgres -c "SELECT 1 FROM pg_database WHERE datname = 'trakt'")" != "1" ]]; then
  log "creating the trakt database"
  psql_tkiller -d postgres -c 'CREATE DATABASE trakt'
fi

# Nothing signs in over TCP: peer authentication on the socket is the only way
# in, and the role has no password to lose.
psql_tkiller -d postgres -c 'ALTER ROLE tkiller PASSWORD NULL'

# The app applies its own migrations at startup (see docs/architecture/
# omnibus-image.md), so there is no schema work here. Keeping it that way is
# what lets the same binary run as a worker that cannot migrate.
