#!/command/with-contenv bash
# shellcheck shell=bash
# Map the tkiller account onto PUID and PGID.
set -euo pipefail
# shellcheck source=omnibus/rootfs/etc/tkiller-omnibus/lib.sh
source /etc/tkiller-omnibus/lib.sh

PUID="${PUID:-911}"
PGID="${PGID:-911}"
if [[ ! "$PUID" =~ ^[0-9]+$ || ! "$PGID" =~ ^[0-9]+$ ]]; then
  echo "PUID and PGID must be numeric (got PUID=$PUID PGID=$PGID)" >&2
  exit 1
fi

# Another account on the same uid would make the kernel report that name for
# the app's processes, which breaks PostgreSQL peer authentication: the server
# maps the process's user name to the database role.
other="$(getent passwd "$PUID" | cut -d: -f1 || true)"
if [[ -n "$other" && "$other" != tkiller ]]; then
  echo "PUID $PUID is already used by the $other account in this image; choose another uid" >&2
  exit 1
fi

[[ "$(id -g tkiller)" == "$PGID" ]] || groupmod -o -g "$PGID" tkiller
[[ "$(id -u tkiller)" == "$PUID" ]] || usermod -o -u "$PUID" tkiller

cat <<BANNER
───────────────────────────────────────
trakt-killer omnibus
tkiller uid: $(id -u tkiller)
tkiller gid: $(id -g tkiller)
───────────────────────────────────────
BANNER
